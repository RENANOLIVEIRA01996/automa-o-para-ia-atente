# Copie para .env e preencha valores próprios. Não use credenciais reais aqui.
DATABASE_URL=postgresql://recepia:CHANGE_THIS@postgres:5432/recepia
POSTGRES_PASSWORD=CHANGE_THIS
APP_URL=http://localhost:8000
# URL HTTPS do site público para a Evolution buscar o vídeo institucional.
PUBLIC_BASE_URL=

JWT_SECRET=CHANGE_ME_generate_64_hex_characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
ADMIN_API_KEY=CHANGE_ME_generate_64_hex_characters
ADMIN_PANEL_PASSWORD_HASH=

EVOLUTION_API_URL=http://evolution:8080
# Opcional no Render: injetado automaticamente pelo Blueprint (host:porta privado).
EVOLUTION_API_HOSTPORT=
EVOLUTION_API_KEY=CHANGE_ME_generate_64_hex_characters
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_generate_64_hex_characters
PUBLIC_WEBHOOK_URL=http://api:8000

OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SAAS_LIMITS_ENABLED=false
FILE_UPLOADS_ENABLED=true
# Local: migrações idempotentes no boot. Render: false; preparar Neon manualmente.
RUN_DB_MIGRATIONS_ON_STARTUP=true

# Classificador legado e fallback do atendimento quando OpenRouter está indisponível.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

INTERVALO_CONFIRMACAO_HORAS=24
INTERVALO_LEMBRETE_HORAS=2
TIMEZONE=America/Sao_Paulo
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
