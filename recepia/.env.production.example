# Copie para .env somente na VM. Nunca versione o .env.
# Nome publico com DNS apontando para a VM (sem https://).
DOMAIN=
APP_URL=
# Origem HTTPS canônica do site comercial, sitemap, Open Graph e links da IA.
PUBLIC_SITE_URL=https://recepia.132-226-243-173.sslip.io
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
# Para a instalacao dividida em duas VMs E2 Micro: IPs privados na VCN.
API_PRIVATE_IP=
EVOLUTION_PRIVATE_IP=
DEBUG=false
HTTPS_ENABLED=true

# Dados de negocio da Recepia: sempre Neon, com TLS (sslmode=require).
# Use uma URL de conexao direta para preparar o schema; veja ORACLE_DEPLOY.md.
DATABASE_URL=
RUN_DB_MIGRATIONS_ON_STARTUP=false

# Segredos: gere valores diferentes com `openssl rand -hex 32`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
ADMIN_API_KEY=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# PostgreSQL privado da Evolution. Use senha hexadecimal para ser segura na URI.
POSTGRES_PASSWORD=

# Enderecos internos da rede Docker. O Compose de producao tambem os fixa.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_HOSTPORT=
PUBLIC_WEBHOOK_URL=http://api:8000

# IA existente via OpenRouter; escolha um modelo que suporte ferramentas.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
SAAS_LIMITS_ENABLED=false
FILE_UPLOADS_ENABLED=true

INTERVALO_CONFIRMACAO_HORAS=24
INTERVALO_LEMBRETE_HORAS=2
TIMEZONE=America/Sao_Paulo
